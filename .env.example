# Choose a current provider/model ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=openai/gpt-oss-20b

# Vercel deployments use VERCEL_OIDC_TOKEN automatically.
# For non-Vercel local development only, set an AI Gateway key in .env.local.
AI_GATEWAY_API_KEY=

# Comma-separated browser origins. Native Android requests do not include an HTTP origin.
FIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Passwordless email authentication (server-only; never put credentials in the APK)
# ==========================================

# 1. Email Delivery: Standard SMTP / Gmail App Password
# For Gmail: Use smtp.gmail.com, port 465, your email, and a 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FIN <your-verified-sender@example.com>"

# PostgreSQL for users, hashed OTPs, sessions and shared rate-limit records.
DATABASE_URL=
# Direct/non-pooled URL for schema migrations; application traffic stays pooled.
DATABASE_URL_UNPOOLED=
# Generate a random secret of at least 32 characters, privately.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://hackmatrix-50.vercel.app
# For npm run dev use BETTER_AUTH_URL=http://localhost:3000 instead.
# Run npm run auth:migrate once against the intended database before enabling login.
